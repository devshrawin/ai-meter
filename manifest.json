{
  "manifest_version": 3,
  "name": "AI Meter",
  "version": "0.1.0",
  "description": "See how much of your usage limit is left on Claude, ChatGPT, Gemini, Grok and Perplexity.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "AI Meter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*"
      ],
      "js": ["src/inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*"
      ],
      "js": [
        "src/core/quotas.js",
        "src/core/common.js",
        "src/core/store.js",
        "src/core/banner.js",
        "src/core/widget.js",
        "src/adapters/claude.js",
        "src/adapters/chatgpt.js",
        "src/adapters/gemini.js",
        "src/adapters/grok.js",
        "src/adapters/perplexity.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
